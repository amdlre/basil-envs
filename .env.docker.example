# Copy to `.env` next to docker-compose.yml (docker compose reads it automatically).
# Generate secrets:  openssl rand -base64 32   (master key)   ·   openssl rand -base64 48   (JWT)

POSTGRES_PASSWORD=
# 32 random bytes, base64. BACK THIS UP SEPARATELY — without it, database backups can't be decrypted.
MASTER_ENCRYPTION_KEY=
JWT_SECRET=

# Public URL (behind your HTTPS reverse proxy)
NEXT_PUBLIC_APP_URL=https://vault.example.com
APP_TIME_ZONE=Asia/Riyadh
# Host port the app is published on (bound to 127.0.0.1)
APP_PORT=3000

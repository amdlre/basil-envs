# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://vault:vault@localhost:5432/vault

# ─── Security (server-only — never commit real values) ─────
# 32 random bytes, base64. Generate: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=
# At least 32 random chars. Generate: openssl rand -base64 48
JWT_SECRET=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
